# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection used by the API, seed and tests.
# With docker compose (db service) this matches the default below.
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety

# Separate database used by the integration tests. It is created on demand.
TEST_DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety_test

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Browser origin allowed by CORS (comma-separated list is supported)
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Redis: report cache + BullMQ reminder job
# Leave REDIS_URL empty to run the API without Redis (cache and job disabled).
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REPORT_CACHE_TTL_SECONDS=300
ENABLE_REMINDER_JOB=false
REMINDER_CRON=0 8 * * *

# ---------------------------------------------------------------------------
# Client (Vite). Leave empty in development to use the Vite proxy.
# ---------------------------------------------------------------------------
VITE_API_URL=

# ---------------------------------------------------------------------------
# Docker compose overrides (only used by docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=sweety
POSTGRES_PASSWORD=sweety
POSTGRES_DB=sweety
