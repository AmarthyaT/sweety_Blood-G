{
  "name": "sweety-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sweety API - Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node src/db/setup.js",
    "db:seed": "node src/db/seed.js",
    "worker": "node src/jobs/worker.js",
    "job:run": "node src/jobs/run-reminder.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.40.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  }
}
